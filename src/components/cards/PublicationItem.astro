---
import type { CollectionEntry } from 'astro:content';
import { site } from '@/config/site';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { cn } from '@/lib/utils';

interface Props {
  publication: CollectionEntry<'publications'>;
  showAbstract?: boolean;
  class?: string;
}
const { publication, showAbstract = false, class: className } = Astro.props;
const { title, authors, venue, year, type, doi, url, abstract } = publication.data;
const href = doi ? `https://doi.org/${doi}` : url;
---

<article class={cn('group grid gap-4 border-t border-border py-8 md:grid-cols-12 md:gap-6', className)}>
  <div class="flex items-center gap-3 md:col-span-2 md:flex-col md:items-start">
    <span class="font-display text-2xl text-muted-foreground tabular-nums">{year}</span>
    <Badge variant={type === 'journal' ? 'primary' : 'accent'} class="capitalize">{type.replace('-', ' ')}</Badge>
  </div>
  <div class="md:col-span-8">
    <h3 class="text-xl leading-snug font-medium text-balance md:text-2xl">
      {
        href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary" data-sound="hover">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="mt-2 text-sm text-muted-foreground">
      {
        authors.map((a, i) => (
          <>
            <span class={a === site.name ? 'font-semibold text-foreground' : undefined}>{a}</span>
            {i < authors.length - 1 && ', '}
          </>
        ))
      }
    </p>
    <p class="mt-1 text-sm text-muted-foreground italic">{venue}</p>
    {showAbstract && abstract && <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">{abstract}</p>}
  </div>
  <div class="flex items-start md:col-span-2 md:justify-end">
    {
      href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-xs transition-colors hover:border-primary hover:text-primary"
          data-sound="click"
        >
          {doi ? 'DOI' : 'Link'} <Icon name="arrow-up-right" class="size-3.5" />
        </a>
      )
    }
  </div>
</article>
