---
/**
 * Training / certification card. If the entry has an `image` (certificate scan),
 * the thumbnail opens a full-size view in the lightbox (scripts/lightbox.ts).
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import CoverImage from '@/components/ui/CoverImage.astro';
import Pattern from '@/components/ui/Pattern.astro';
import Icon from '@/components/ui/Icon.astro';
import { cn, formatDate } from '@/lib/utils';

interface Props {
  cert: CollectionEntry<'certifications'>;
  class?: string;
}
const { cert, class: className } = Astro.props;
const { title, issuer, type, format, date, expires, credentialId, url, skills, image, imageAlt } = cert.data;

// Full-size, optimised version for the lightbox
const full =
  typeof image === 'string'
    ? image
    : image
      ? (await getImage({ src: image, width: Math.min(1800, image.width), format: 'webp' })).src
      : undefined;

const monthYear = { year: 'numeric', month: 'short' } as const;
const expired = expires ? expires.valueOf() < Date.now() : false;
---

<Card class={cn('group flex h-full flex-col overflow-hidden', className)} data-cert-type={type}>
  {
    image ? (
      <a
        href={full}
        class="relative block cursor-zoom-in border-b border-border"
        aria-label={`View certificate: ${title}`}
        data-lightbox
        data-caption={`${title} · ${issuer}`}
        data-sound="click"
      >
        <CoverImage src={image} alt={imageAlt ?? `Certificate: ${title}`} class="aspect-[1.414] bg-muted" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" widths={[480, 800]} zoom />
        <span class="absolute right-3 bottom-3 inline-flex translate-y-1 items-center gap-1.5 rounded-full bg-foreground/90 px-3 py-1.5 text-xs font-medium text-background opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          <Icon name="maximize" class="size-3.5" /> View certificate
        </span>
      </a>
    ) : (
      <div class="relative grid aspect-[1.414] place-items-center overflow-hidden border-b border-border bg-muted/60 text-primary/30">
        <Pattern variant="contours" class="absolute inset-0" />
        <span class="relative grid size-20 place-items-center rounded-full border border-border bg-card text-primary shadow-sm">
          <Icon name={type === 'certification' ? 'badge-check' : 'award'} class="size-9" strokeWidth={1.4} />
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-4 flex items-center justify-between gap-3">
      <Badge variant={type === 'certification' ? 'primary' : 'accent'}>{type === 'certification' ? 'Certification' : 'Training'}</Badge>
      <time datetime={date.toISOString()} class="text-xs text-muted-foreground tabular-nums">{formatDate(date, monthYear)}</time>
    </div>
    <h3 class="text-xl leading-snug font-medium text-balance">{title}</h3>
    <p class="mt-1 text-sm text-primary">{issuer}</p>
    {format && <p class="mt-1 text-sm text-muted-foreground">{format}</p>}

    {
      skills.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {skills.map((s) => (
            <li class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground">{s}</li>
          ))}
        </ul>
      )
    }

    <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-6 text-xs text-muted-foreground">
      <div class="space-y-1">
        {credentialId && <p>ID <span class="font-mono text-foreground">{credentialId}</span></p>}
        {expires && <p class={cn(expired && 'text-destructive')}>{expired ? 'Expired' : 'Valid until'} {formatDate(expires, monthYear)}</p>}
      </div>
      {
        url && (
          <a href={url} target="_blank" rel="noopener noreferrer" class="link-sweep relative z-10 font-medium text-foreground" data-sound="click">
            {type === 'certification' ? 'Verify' : 'Course page'} <Icon name="arrow-up-right" class="size-3.5" />
          </a>
        )
      }
    </div>
  </div>
</Card>
