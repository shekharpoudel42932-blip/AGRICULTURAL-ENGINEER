---
import type { CollectionEntry } from 'astro:content';
import { cn, formatDate, readingTime } from '@/lib/utils';
import Icon from '@/components/ui/Icon.astro';
import CoverImage from '@/components/ui/CoverImage.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** "card" for grids, "row" for compact lists */
  layout?: 'card' | 'row';
  class?: string;
}
const { post, layout = 'card', class: className } = Astro.props;
const { title, description, date, tags, cover, coverAlt } = post.data;
const href = `/blog/${post.id}`;
---

{
  layout === 'row' ? (
    <a
      href={href}
      class={cn('group grid gap-4 border-t border-border py-8 transition-colors md:grid-cols-12 md:gap-6', className)}
      data-sound="hover"
    >
      <div class="flex gap-4 text-sm text-muted-foreground tabular-nums md:col-span-2 md:flex-col md:gap-1">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body)}</span>
      </div>
      <div class={cover ? 'md:col-span-6' : 'md:col-span-9'}>
        <h3 class="text-2xl leading-tight font-medium transition-colors group-hover:text-primary md:text-3xl">{title}</h3>
        <p class="mt-2 text-muted-foreground">{description}</p>
        <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium">
          Read post
          <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
        </span>
      </div>
      {cover && (
        <CoverImage
          src={cover}
          alt={coverAlt ?? title}
          class="aspect-[16/10] rounded-lg md:col-span-4"
          sizes="(min-width: 768px) 30vw, 100vw"
          widths={[400, 800]}
          zoom
        />
      )}
    </a>
  ) : (
    <article class={cn('group relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card', className)} data-card>
      {cover && (
        <CoverImage
          src={cover}
          alt={coverAlt ?? title}
          class="aspect-[16/10]"
          sizes="(min-width: 768px) 33vw, 100vw"
          widths={[400, 800]}
          zoom
        />
      )}
      <div class="flex flex-1 flex-col p-6">
        <div class={cn('flex items-center justify-between text-xs text-muted-foreground', cover ? 'mb-4' : 'mb-8')}>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>{readingTime(post.body)}</span>
        </div>
        <h3 class="text-2xl leading-tight font-medium text-balance">
          <a href={href} class="after:absolute after:inset-0" data-sound="hover">
            {title}
          </a>
        </h3>
        <p class="mt-3 line-clamp-3 text-muted-foreground">{description}</p>
        <div class="mt-auto flex items-center justify-between pt-8">
          <span class="text-xs text-primary">{tags[0] && `#${tags[0]}`}</span>
          <span class="grid size-9 place-items-center rounded-full border border-border transition-colors duration-300 group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground">
            <Icon name="arrow-right" class="size-4" />
          </span>
        </div>
      </div>
    </article>
  )
}
