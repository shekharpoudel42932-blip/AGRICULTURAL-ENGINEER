---
import { cn } from '@/lib/utils';

interface Props {
  title?: string;
  tone?: 'info' | 'warning';
}
const { title, tone = 'info' } = Astro.props;
---

<aside
  class={cn(
    'not-prose my-8 rounded-xl border-l-4 p-5',
    tone === 'info' ? 'border-primary bg-primary/5' : 'border-accent bg-accent/10',
  )}
>
  {title && <p class="mb-1 font-display text-lg font-medium">{title}</p>}
  <div class="text-muted-foreground"><slot /></div>
</aside>
