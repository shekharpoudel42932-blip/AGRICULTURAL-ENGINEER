---
/**
 * Full-bleed call-to-action band. Content sits in the shared Container so its
 * edges line up with every other section on the page.
 */
import { site } from '@/config/site';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Pattern from '@/components/ui/Pattern.astro';
import Icon from '@/components/ui/Icon.astro';
---

<section class="relative overflow-hidden bg-primary py-20 text-primary-foreground md:py-28">
  <div class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true">
    <Pattern variant="rows" draw />
  </div>
  <Container class="relative">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-6 text-primary-foreground/70">{site.availability}</p>
        <h2 class="text-4xl leading-[1.02] font-medium md:text-6xl" data-split>Have a field problem worth engineering?</h2>
        <p class="mt-6 max-w-xl text-lg text-primary-foreground/80" data-reveal>
          Whether it's an irrigation design, a research collaboration or a machinery prototype, I'd love to hear about it.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:col-span-4 md:justify-end" data-reveal>
        <Button href="/contact" variant="accent" size="lg">Start a conversation <Icon name="arrow-right" class="size-4" /></Button>
        <Button href={`mailto:${site.email}`} size="lg" class="bg-primary-foreground/10 text-primary-foreground hover:bg-primary-foreground/20">
          <Icon name="mail" class="size-4" /> Email me
        </Button>
      </div>
    </div>
  </Container>
</section>
