---
import { expertise, site } from '@/config/site';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
---

<Section id="about">
  <div class="grid gap-12 md:grid-cols-12">
    <div class="md:col-span-7">
      <SectionHeading index="01" eyebrow="About" title="Engineering at the meeting point of soil, water and machines." class="mb-8 md:mb-8" />
      <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted-foreground" data-reveal>
        <p>
          I'm {site.name}, an agricultural engineer who designs practical systems that farmers can actually afford
          and maintain. My work ranges from drip networks and soil-moisture sensing to low-draft implements and
          solar post-harvest dryers.
        </p>
        <p>
          My approach is field-first. I measure before modelling, build prototypes before scaling, and judge
          success by water saved, labour reduced and harvests protected.
        </p>
      </div>
      <LinkArrow href="/about" class="mt-8" data-reveal="fade">More about me</LinkArrow>
    </div>

    <aside class="md:col-span-5 md:pt-24">
      <p class="eyebrow mb-5" data-reveal="fade">Areas of expertise</p>
      <ul class="flex flex-wrap gap-2" data-stagger>
        {
          expertise.map((e) => (
            <li class="rounded-full border border-border bg-card px-4 py-2 text-sm transition-colors duration-300 hover:border-primary hover:bg-primary hover:text-primary-foreground" data-sound="hover">
              {e}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>
