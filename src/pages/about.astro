---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Pattern from '@/components/ui/Pattern.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Stats from '@/components/sections/Stats.astro';
import ContactCTA from '@/components/sections/ContactCTA.astro';
import { expertise, site, tools } from '@/config/site';

const values = [
  { title: 'Measure first', body: 'Every design starts with field data: soil, water, energy and labour. Assumptions come later.' },
  { title: 'Build for the farmer', body: 'If a system can’t be repaired locally with local parts, it isn’t finished.' },
  { title: 'Publish what works', body: 'Sharing data and designs openly helps the next engineer start further ahead.' },
];
---

<BaseLayout title="About" description={`About ${site.name}, ${site.role}.`}>
  <PageHeader eyebrow="About" title="Field engineer, researcher, tinkerer." />

  <Section class="pt-0 md:pt-0">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-primary/10 text-primary md:col-span-5" data-reveal="scale">
        <!-- Replace with a portrait: <Image src={portrait} alt="..." class="size-full object-cover" /> -->
        <Pattern variant="contours" draw class="opacity-50" />
        <span class="absolute bottom-5 left-5 rounded-full bg-card/80 px-3 py-1 text-xs backdrop-blur">Portrait placeholder</span>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-muted-foreground md:col-span-7" data-reveal>
        <p class="font-display text-3xl leading-tight text-foreground md:text-4xl">
          I grew up between paddy fields and workshops, and agricultural engineering turned out to be where those two worlds meet.
        </p>
        <p>
          Today I work on the systems behind a good harvest: how water reaches the root zone, how machines meet the soil,
          and how produce survives the trip from field to market. My research focuses on closed-loop irrigation
          scheduling that combines low-cost sensors with satellite data.
        </p>
        <p>
          Outside research, I consult on irrigation design for farmer cooperatives and teach practical workshops
          on fertigation and pump efficiency.
        </p>
        <div class="flex flex-wrap gap-3 pt-4">
          <Button href="/contact">Work with me <Icon name="arrow-right" class="size-4" /></Button>
          <Button href="/Shekhar_Poudel_CV.pdf" download="Shekhar_Poudel_CV.pdf" data-astro-prefetch="false" variant="outline"><Icon name="file" class="size-4" /> Download CV</Button>
        </div>
      </div>
    </div>
  </Section>

  <Stats />

  <Section>
    <SectionHeading index="01" eyebrow="Principles" title="How I work" />
    <div class="grid gap-6 md:grid-cols-3" data-stagger>
      {
        values.map((v, i) => (
          <div class="rounded-xl border border-border bg-card p-8" data-card>
            <span class="font-display text-5xl text-accent">{`0${i + 1}`}</span>
            <h3 class="mt-6 text-2xl font-medium">{v.title}</h3>
            <p class="mt-3 text-muted-foreground">{v.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section class="bg-card">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <SectionHeading index="02" eyebrow="Expertise" title="Disciplines" class="mb-8 md:mb-8" />
        <ul class="flex flex-wrap gap-2" data-stagger>
          {expertise.map((e) => <li class="rounded-full border border-border bg-background px-4 py-2 text-sm">{e}</li>)}
        </ul>
      </div>
      <div>
        <SectionHeading index="03" eyebrow="Toolkit" title="Software & hardware" class="mb-8 md:mb-8" />
        <ul class="grid grid-cols-2 gap-x-6" data-stagger>
          {
            tools.map((t) => (
              <li class="flex items-center gap-2 border-b border-border py-3 text-sm">
                <span class="size-1.5 rounded-full bg-primary" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <ContactCTA />
</BaseLayout>
